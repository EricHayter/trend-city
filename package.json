{
  "name": "trend-city",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TREND CITY — a high-speed cel-shaded 3D action platformer. Zero external assets; every mesh, texture and sound generated in code.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "shots": "node harness/capture.mjs",
    "shots:stills": "node harness/capture.mjs --set=stills",
    "shots:motion": "node harness/capture.mjs --set=motion",
    "shots:turntable": "node harness/capture.mjs --set=turntable",
    "shots:perf": "node harness/capture.mjs --set=perf"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^7.1.5"
  }
}
